{
  "output_columns": [
    "id",
    "dob",
    "student_name",
    "term",
    "course",
    "course_description",
    "grade",
    "units_attempted",
    "units_completed",
    "gpa_term",
    "program_description",
    "status",
    "exp_grad_date",
    "ft_pt",
    "first_term",
    "lda",
    "session",
    "grad_date"
  ],
  "record_separator": "Bayamon Community College",
  "exclude_patterns": [
    "17\\s+Calle\\s+Maceo",
    "Bayam[oóÃ³]+n,?\\s*PR\\s+\\d+",
    "\\(787\\)\\s*780-4242",
    "https?://bccpr\\.org",
    "bccpr\\.org",
    "Official Student Transcript",
    "Not Official unless signed.*",
    "_{5,}",
    "Registrar",
    "Wednesday,.*Page\\s+\\d+.*",
    "Thursday,.*Page\\s+\\d+",
    "^\\s*Absent\\s+Tardy\\s+Left Early",
    "^\\s*Hours\\s+Hours\\s+Hours",
    "^\\s*Term\\s+Course\\s+Attended",
    "\\(Cumulative GPA\\)",
    "Powered by TCPDF.*",
    "^Course\\s+Course Description\\s+Grade\\s+Units",
    "Attendance Summary",
    "Total Required Hours.*",
    "Total Attended Hours.*",
    "Total Transfer Hours.*",
    "Total Hours Remaining.*",
    "Total Scheduled Hours.*",
    "Attendance Percentage.*",
    "Cumulative Total:.*",
    "Term.*Total:.*"
  ],
  "name_detection": {
    "output_column": "student_name",
    "pattern": "^([A-Za-zÀ-ÿ' -]+,\\s*[A-Za-zÀ-ÿ' -]+)\\s*$",
    "stop_at": "Program Description:"
  },
  "address_block": {
    "output_column": "address",
    "stop_prefixes": [
      "Program Description:",
      "First Term:",
      "Status:",
      "FT/PT:",
      "Exp Grad Date:",
      "Grad Date:",
      "Drop Date:",
      "Group:",
      "Session:"
    ]
  },
  "summary_fields": [
    {
      "name": "id",
      "pattern": "^ID:\\s*([A-Z0-9]+)$",
      "flags": "MULTILINE"
    },
    {
      "name": "dob",
      "pattern": "^DOB:\\s*(\\d{2}/\\d{2}/\\d{4})$",
      "flags": "MULTILINE"
    }
  ],
  "repeating_sections": [
    {
      "name": "program",
      "marker": "Program Description:",
      "marker_line_fields": [],
      "next_line_value": {
        "name": "program_description"
      },
      "sub_fields": [
        {
          "name": "first_term",
          "pattern": "First Term:\\s*(\\d{2}/\\d{2}/\\d{4})"
        },
        {
          "name": "exp_grad_date",
          "pattern": "Exp Grad Date:\\s*(\\d{2}/\\d{2}/\\d{4})"
        },
        {
          "name": "ft_pt",
          "pattern": "FT/PT:\\s*(.+?)$"
        },
        {
          "name": "status",
          "pattern": "Status:\\s*(.+?)(?:\\s+Grad Date:|\\s+Session:|$)"
        },
        {
          "name": "grad_date",
          "pattern": "Grad Date:\\s*(\\d{2}/\\d{2}/\\d{4})"
        },
        {
          "name": "session",
          "pattern": "Session:\\s*(.+?)$"
        }
      ]
    }
  ],
  "context_fields": [
    {
      "name": "term",
      "pattern": "^Term:\\s*([A-Za-z0-9-]+)\\s*$"
    }
  ],
  "program_match": {
    "term_date_normalization": {
      "formats": [
        {
          "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})$",
          "normalized": "{1}-{2}-{3}"
        },
        {
          "pattern": "^[A-Z](\\d{2})(\\d{2})$",
          "normalized": "20{2}-{1}-01"
        }
      ]
    },
    "range_start_field": "first_term",
    "range_end_field_priority": [
      "grad_date",
      "exp_grad_date"
    ],
    "range_end_fallback": "next_program_block.first_term",
    "date_format": "MM/DD/YYYY",
    "reset_program_fields_on_new_block": true
  },
  "data_rows": {
    "pattern": "^([A-Z]{2,4}\\d{3})\\s+(.+?)\\s+([A-FWIDw-]|-)\\s+(\\d+\\.\\d{2})\\s+(\\d+\\.\\d{2})\\s*$",
    "columns": [
      "course",
      "course_description",
      "grade",
      "units_attempted",
      "units_completed"
    ],
    "carry_context": true,
    "transforms": {}
  }
}