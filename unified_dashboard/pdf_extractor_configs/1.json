      "name": "pr_00961_campus",
      "pattern": "PR\\ 00961\\ Campus:[ \\t]*(.+?)(?=\\r?\\n|$)"
    },
    {
      "name": "program_description",
      "pattern": "Program\\ Description:[ \\t]*(.+?)(?=[ \\t]+Asistente\\ de\\ Group:|\\r?\\n|$)"
    },
    {
      "name": "asistente_de_group",
      "pattern": "Asistente\\ de\\ Group:[ \\t]*(.+?)(?=\\r?\\n|$)"
    },
    {
      "name": "first_term",
