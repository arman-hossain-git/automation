    },
    {
      "name": "exp_grad_date",
      "pattern": "Exp\\ Grad\\ Date:[ \\t]*(\\d{2}/\\d{2}/\\d{4})"
    },
    {
      "name": "ft_pt",
      "pattern": "FT/PT:[ \\t]*(.+?)(?=\\r?\\n|$)"
    },
    {
      "name": "status",
      "pattern": "Status:[ \\t]*(.+?)(?=[ \\t]+Graduated\\ Session:|\\r?\\n|$)"
    },
    {
      "name": "graduated_session",
      "pattern": "Graduated\\ Session:[ \\t]*(.+?)(?=\\r?\\n|$)"
    }
  ],
  "data_rows": {
    "pattern": "^\\s*(\\d{2}/\\d{2}/\\d{4})\\s+([A-Za-z0-9\\-]+)\\s+([A-Za-z0-9\\-]+)\\s+(.+?)\\s+(.+?)\\s+([-]?\\$?[\\d,.]+)\\s*$",
    "columns": [
      "trans_date",
      "ledger_code_description",
      "receipt_check",
      "debit",
      "credit",
      "balance"
    ]
  },
  "output_columns": [
